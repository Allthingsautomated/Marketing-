# ============================================
# AI Lead Engine — Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

# ── AI (at minimum, fill in one of these) ──
ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here  # optional alternative

# ── Google Places API (for Google Maps scraping) ──
# Get free key at: console.cloud.google.com → Enable "Places API"
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# ── Yelp Fusion API (for Yelp scraping) ──
# Get free key at: fusion.yelp.com
YELP_API_KEY=your_yelp_api_key_here

# ── Google Ads API (Phase 4 — optional for now) ──
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Meta Ads API (Phase 4 — optional for now) ──
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── App Settings ──
SECRET_KEY=change-this-to-a-random-string
PORT=8000
DEBUG=false
DATABASE_URL=sqlite:///lead_engine.db
